[%# ProcessPath: compact read-only graph in AgentTicketZoom. %]
<details id="ProcessPathWidget" class="ProcessPathWidget WidgetSimple DontPrint" [% IF !Data.Completed %]open="open"[% END %]>
    <summary class="pp-summary">
        <span class="pp-summary-label">
            <i class="fa [% IF Data.Completed %]fa-check-circle pp-summary-done[% ELSE %]fa-sitemap[% END %]" aria-hidden="true"></i>
            <strong>[% Translate('Process path') | html %]: [% Data.Name | html %]</strong>
            <span class="pp-status">[% IF Data.Completed %][% Translate('Process completed') | html %][% ELSE %][% Translate('Current activity') | html %]: [% Data.CurrentName | html %][% END %]</span>
        </span>
        <span class="pp-chevron" aria-hidden="true"><i class="fa fa-chevron-down"></i></span>
    </summary>
    <div class="pp-content">
        <div class="pp-flow [% IF Data.Width %]pp-flow-with-graph[% END %]">
            [% IF Data.PastCount %]
                <div class="pp-past" tabindex="0" role="list" aria-label="[% Translate('Visited') | html %]">
                    [% FOREACH Step IN Data.PastNodes %]
                        <div class="pp-past-step" role="listitem" title="[% Step.Name | html %]">
                            <span class="pp-past-name">[% Step.Name | html %]</span>
                        </div>
                    [% END %]
                </div>
            [% END %]
            [% IF Data.Width %]
                <div class="pp-scroller" role="region" aria-label="[% Translate('Process graph') | html %]" tabindex="0">
                    <svg class="pp-graph" xmlns="http://www.w3.org/2000/svg" width="[% Data.Width %]" height="[% Data.Height %]" viewBox="0 0 [% Data.Width %] [% Data.Height %]" role="img" aria-label="[% Translate('Process path') | html %]: [% Data.Name | html %]">
                        [% FOREACH Edge IN Data.Edges %]
                            <path d="[% Edge.Path | html %]" class="pp-edge" fill="none"/>
                        [% END %]
                        [% FOREACH Node IN Data.Nodes %]
                            <g class="pp-node pp-[% Node.State | html %]" transform="translate([% Node.X %],[% Node.Y %])">
                                <title>[% Node.Name | html %] [% IF Node.IsCurrent %]([% Translate('Current activity') | html %])[% END %]</title>
                                <rect class="pp-node-box" width="[% Node.W %]" height="[% Node.H %]" rx="6" ry="6"/>
                                [% FOREACH Line IN Node.Lines %]
                                    <text x="[% Node.TextX %]" y="[% 20 + loop.index * 16 %]" class="pp-node-name" text-anchor="middle">[% Line | html %]</text>
                                [% END %]
                                [% IF Node.IsCurrent %]
                                    <circle cx="12" cy="[% Node.H - 15 %]" r="5" class="pp-active-circle"/>
                                    <text x="24" y="[% Node.H - 11 %]" class="pp-node-subtitle">[% Translate('Current') | html %]</text>
                                [% END %]
                            </g>
                        [% END %]
                    </svg>
                </div>
            [% END %]
        </div>
    </div>
</details>
